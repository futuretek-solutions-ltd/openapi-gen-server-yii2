{
  "openapi": "3.0.3",
  "info": {
    "title": "Edge Cases API",
    "version": "1.0.0"
  },
  "paths": {
    "/items": {
      "get": {
        "operationId": "listItems",
        "tags": ["Item"],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 1 }
          },
          {
            "name": "perPage",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "default": 25 }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["name", "date", "price"],
              "x-enum": "SortField"
            }
          },
          {
            "name": "X-Request-Id",
            "in": "header",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaginatedItems" }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createItem",
        "tags": ["Item"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateItemRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      }
    },
    "/items/{itemId}": {
      "parameters": [
        {
          "name": "itemId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "get": {
        "operationId": "getItem",
        "tags": ["Item"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "patchItem",
        "tags": ["Item"],
        "parameters": [
          {
            "name": "dryRun",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean", "default": false }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/PatchItemRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      }
    },
    "/upload": {
      "post": {
        "operationId": "uploadMultipleFiles",
        "tags": ["Upload"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/MultiFileUpload" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "uploadedCount": { "type": "integer" },
                    "message": { "type": "string" }
                  },
                  "required": ["uploadedCount", "message"]
                }
              }
            }
          }
        }
      }
    },
    "/no-tags": {
      "get": {
        "operationId": "noTagsEndpoint",
        "responses": {
          "204": { "description": "No content" }
        }
      }
    },
    "/reports": {
      "x-controller": "Report",
      "get": {
        "operationId": "listReports",
        "x-controller": "CustomReport",
        "tags": ["Report"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Item" }
                }
              }
            }
          }
        }
      }
    },
    "/mixed/{id}": {
      "put": {
        "operationId": "updateMixed",
        "tags": ["Mixed"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          },
          {
            "name": "force",
            "in": "query",
            "required": true,
            "schema": { "type": "boolean" }
          },
          {
            "name": "reason",
            "in": "query",
            "required": false,
            "schema": { "type": "string" }
          },
          {
            "name": "priority",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "enum": [1, 2, 3, 4, 5],
              "x-enum": "Priority"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Item" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Item" }
              }
            }
          }
        }
      }
    },
    "/duplicate": {
      "get": {
        "operationId": "listReports",
        "tags": ["Dup"],
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/notifications": {
      "post": {
        "operationId": "sendNotification",
        "tags": ["Notification"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Notification" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "status": { "type": "string" }
                  },
                  "required": ["id", "status"]
                }
              }
            }
          }
        }
      }
    },
    "/notifications/auto": {
      "post": {
        "operationId": "sendAutoNotification",
        "tags": ["Notification"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AutoNotification" }
            }
          }
        },
        "responses": {
          "200": { "description": "OK" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name", "type"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "$ref": "#/components/schemas/ItemType" },
          "price": { "type": "number", "format": "double", "nullable": true },
          "quantity": { "type": "integer", "default": 0 },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metadata": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          },
          "relatedItems": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Item" }
          },
          "createdAt": { "type": "string", "format": "date-time" },
          "settings": {
            "type": "object",
            "properties": {
              "notify": { "type": "boolean", "default": true },
              "color": { "type": "string", "nullable": true }
            }
          },
          "statusCodes": {
            "type": "array",
            "items": { "type": "integer" }
          },
          "flags": {
            "type": "array",
            "items": { "type": "boolean" }
          }
        }
      },
      "ItemType": {
        "type": "string",
        "enum": ["physical", "digital", "service"],
        "description": "Type of item"
      },
      "CreateItemRequest": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string", "description": "Item name" },
          "type": { "$ref": "#/components/schemas/ItemType" },
          "price": { "type": "number", "nullable": true },
          "isActive": { "type": "boolean", "default": true }
        }
      },
      "PatchItemRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "nullable": true },
          "price": { "type": "number", "nullable": true },
          "type": { "$ref": "#/components/schemas/ItemType" }
        }
      },
      "PaginatedItems": {
        "type": "object",
        "required": ["items", "total", "page"],
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/Item" }
          },
          "total": { "type": "integer" },
          "page": { "type": "integer" }
        }
      },
      "MultiFileUpload": {
        "type": "object",
        "required": ["files", "description"],
        "properties": {
          "files": {
            "type": "array",
            "items": { "type": "string", "format": "binary" }
          },
          "description": { "type": "string" },
          "tags": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      },
      "ExtendedItem": {
        "allOf": [
          { "$ref": "#/components/schemas/Item" },
          {
            "type": "object",
            "properties": {
              "extraField": { "type": "string" },
              "weight": { "type": "number", "format": "float" }
            }
          }
        ]
      },
      "EmptySchema": {
        "type": "object"
      },
      "Notification": {
        "type": "object",
        "required": ["channel"],
        "oneOf": [
          { "$ref": "#/components/schemas/EmailNotification" },
          { "$ref": "#/components/schemas/SmsNotification" }
        ],
        "discriminator": {
          "propertyName": "channel",
          "mapping": {
            "email": "#/components/schemas/EmailNotification",
            "sms": "#/components/schemas/SmsNotification"
          }
        },
        "properties": {
          "channel": { "type": "string" },
          "message": { "type": "string" }
        }
      },
      "AutoNotification": {
        "type": "object",
        "required": ["type"],
        "oneOf": [
          { "$ref": "#/components/schemas/EmailNotification" },
          { "$ref": "#/components/schemas/SmsNotification" }
        ],
        "discriminator": {
          "propertyName": "type"
        },
        "properties": {
          "type": { "type": "string" }
        }
      },
      "EmailNotification": {
        "type": "object",
        "required": ["emailAddress", "subject"],
        "properties": {
          "emailAddress": { "type": "string", "format": "email" },
          "subject": { "type": "string" },
          "htmlBody": { "type": "string" }
        }
      },
      "SmsNotification": {
        "type": "object",
        "required": ["phoneNumber"],
        "properties": {
          "phoneNumber": { "type": "string" },
          "sender": { "type": "string" }
        }
      }
    }
  }
}




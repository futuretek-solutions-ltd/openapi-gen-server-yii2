{
  "openapi": "3.0.3",
  "info": {
    "title": "Pet Store API",
    "version": "1.0.0",
    "description": "A sample Pet Store API for testing the generator"
  },
  "paths": {
    "/pets": {
      "x-controller": "Pet",
      "get": {
        "operationId": "listPets",
        "summary": "List all pets",
        "tags": ["Pet"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            },
            "description": "Maximum number of pets to return"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["available", "pending", "sold"],
              "x-enum": "PetStatus",
              "x-enum-descriptions": [
                "Pet is available for adoption",
                "Pet adoption is pending",
                "Pet has been sold"
              ]
            },
            "description": "Filter by pet status"
          }
        ],
        "responses": {
          "200": {
            "description": "A list of pets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createPet",
        "summary": "Create a pet",
        "tags": ["Pet"],
        "security": [
          { "bearerAuth": [] }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Pet created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          }
        }
      }
    },
    "/pets/{petId}": {
      "x-controller": "Pet",
      "get": {
        "operationId": "getPet",
        "summary": "Get a pet by ID",
        "tags": ["Pet"],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A pet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updatePet",
        "summary": "Update a pet",
        "tags": ["Pet"],
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pet updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          }
        }
      },
      "delete": {
        "operationId": "deletePet",
        "summary": "Delete a pet",
        "tags": ["Pet"],
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Pet deleted"
          }
        }
      }
    },
    "/pets/{petId}/photo": {
      "x-controller": "Pet",
      "post": {
        "operationId": "uploadPetPhoto",
        "summary": "Upload a photo for a pet",
        "tags": ["Pet"],
        "security": [
          { "bearerAuth": [] }
        ],
        "parameters": [
          {
            "name": "petId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/PetPhotoUpload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Photo uploaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Pet"
                }
              }
            }
          }
        }
      }
    },
    "/categories": {
      "x-controller": "Category",
      "get": {
        "operationId": "listCategories",
        "summary": "List all categories",
        "tags": ["Category"],
        "responses": {
          "200": {
            "description": "A list of categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Category"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PetStatus": {
        "type": "string",
        "description": "Pet availability status",
        "enum": ["available", "pending", "sold"],
        "x-enum-descriptions": [
          "Pet is available for adoption",
          "Pet adoption is pending",
          "Pet has been sold"
        ]
      },
      "Category": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "Category ID"
          },
          "name": {
            "type": "string",
            "description": "Category name"
          }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "name": {
            "type": "string"
          }
        }
      },
      "Pet": {
        "type": "object",
        "required": ["id", "name", "status"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Pet unique identifier"
          },
          "name": {
            "type": "string",
            "description": "Pet name"
          },
          "status": {
            "$ref": "#/components/schemas/PetStatus"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "tags": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "photoUrl": {
            "type": "string",
            "nullable": true,
            "description": "URL to pet photo"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Creation timestamp"
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Pet birth date"
          },
          "vaccinationDates": {
            "type": "array",
            "description": "Dates of vaccinations",
            "items": {
              "type": "string",
              "format": "date"
            }
          }
        }
      },
      "CreatePetRequest": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Pet name"
          },
          "status": {
            "$ref": "#/components/schemas/PetStatus"
          },
          "categoryId": {
            "type": "integer",
            "nullable": true
          },
          "tagIds": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "birthDate": {
            "type": "string",
            "format": "date",
            "nullable": true
          }
        }
      },
      "PetListResponse": {
        "type": "object",
        "required": ["items", "total"],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pet"
            }
          },
          "total": {
            "type": "integer",
            "description": "Total number of pets"
          }
        }
      },
      "PetPhotoUpload": {
        "type": "object",
        "required": ["photo"],
        "properties": {
          "photo": {
            "type": "string",
            "format": "binary",
            "description": "The photo file"
          },
          "caption": {
            "type": "string",
            "nullable": true,
            "description": "Photo caption"
          }
        }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}


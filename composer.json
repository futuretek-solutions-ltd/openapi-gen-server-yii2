{
    "name": "futuretek/openapi-gen-server-yii2",
    "type": "library",
    "version": "1.0.0",
    "description": "OpenAPI server stub generator for Yii2",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Lukáš Černý",
            "email": "lukas.cerny@futuretek.cz",
            "homepage": "https://futuretek.cz",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "futuretek/data-mapper": ">=1.1.0",
        "cebe/php-openapi": "^1.7",
        "symfony/console": "^7.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "futuretek\\openapi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "futuretek\\openapi\\tests\\": "tests/"
        }
    },
    "bin": [
        "bin/openapi-gen"
    ],
    "scripts": {
        "test": "pest --colors=always",
        "generate": "php bin/openapi-gen generate"
    },
    "config": {
        "platform-check": "php-only",
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}

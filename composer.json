{
    "name": "futuretek/openapi-gen-server-yii2",
    "type": "library",
    "description": "OpenAPI server stub generator for Yii2",
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Lukáš Černý",
            "email": "lukas.cerny@futuretek.cz",
            "homepage": "https://futuretek.cz",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.4",
        "futuretek/data-mapper": "^1.2.1",
        "cebe/php-openapi": "^1.8.0",
        "symfony/console": "^7.0",
        "psr/http-message": "^1.0 || ^2.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "yiisoft/yii2": "^2.0.54"
    },
    "autoload": {
        "psr-4": {
            "futuretek\\openapi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "futuretek\\openapi\\tests\\": "tests/"
        }
    },
    "bin": [
        "bin/openapi-gen"
    ],
    "scripts": {
        "test": "pest --colors=always",
        "generate": "php bin/openapi-gen generate"
    },
    "config": {
        "platform-check": "php-only",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "yiisoft/yii2-composer": true
        }
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
